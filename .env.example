# ===================================================
# TaskPilot AI - Environment Configuration Example
# Copy this file to .env and populate your own values.
# NEVER commit your actual .env file or private keys.
# ===================================================

# LLM Provider Configuration
AI_MODEL=gemini-1.5-flash
AI_API_KEY=your_ai_api_key_here

# Celo Network Configuration (Celo Mainnet)
CELO_RPC_URL=https://forno.celo.org
CELO_CHAIN_ID=42220

# Celo x402 Facilitator Endpoint
X402_FACILITATOR_URL=https://api.x402.sepolia.celo.org

# Testnet USDC Address (Celo Sepolia)
CELO_USDC_ADDRESS=0x01C5C0122039549AD1493B8220cABEdD739BC44E

# Agent Wallet (Phase 2 - use a dedicated testnet key with testnet funds only)
AGENT_PRIVATE_KEY=

# ERC-8004 Agent Identity Configuration (Celo Mainnet)
ERC8004_AGENT_ID=9964
AGENT_WALLET_ADDRESS=0x129910Aaf23898DDC16Af3d98178d9Dd0bb4C292
ERC8004_REGISTRY_ADDRESS=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
