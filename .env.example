# Celo x402 Facilitator Endpoint
X402_FACILITATOR_URL=https://api.x402.sepolia.celo.org

# Testnet USDC Address (Celo Sepolia)
CELO_USDC_ADDRESS=0x01C5C0122039549AD1493B8220cABEdD739BC44E

# Agent Wallet (Phase 2 - use a dedicated testnet key with testnet funds only)
AGENT_PRIVATE_KEY=
